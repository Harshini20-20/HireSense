# Local host port for the production Nginx frontend
FRONTEND_PORT=8080

# Keep these pointed at the existing application data
HIRESENSE_DB_FILE=./backend/hiresense.db
HIRESENSE_RESUME_DIR=./backend/storage/resumes

# Optional SQLAlchemy URL. Leave blank to use the local SQLite database.
# For Supabase, set the PostgreSQL URL in your untracked .env file or deployment secret.
DATABASE_URL=

# Resume objects use local bind-mounted storage by default.
RESUME_STORAGE_BACKEND=local

# Required only when RESUME_STORAGE_BACKEND=supabase. Use deployment secrets
# for SUPABASE_SECRET_KEY; never put it in frontend/VITE_ variables.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=hiresense-resumes

# Browser requests use the same-origin Nginx proxy by default
VITE_API_BASE_URL=/api
HIRESENSE_CORS_ORIGINS=http://localhost:8080
